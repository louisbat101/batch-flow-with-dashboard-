// Minimal test to verify pin availability
// Flash this to find which pins are safe

#include <Arduino.h>

#define TEST_PINS {0, 1, 5, 6, 7, 8, 9, 10, 19, 20, 21, 22}

void setup() {
    Serial.begin(115200);
    delay(500);
    
    Serial.println("\n=== Testing GPIO pins ===");
    
    int pins[] = TEST_PINS;
    for (int p : pins) {
        Serial.printf("Testing GPIO %d... ", p);
        pinMode(p, OUTPUT);
        digitalWrite(p, LOW);
        delay(10);
        digitalWrite(p, HIGH);
        delay(10);
        digitalWrite(p, LOW);
        Serial.println("OK");
    }
    
    Serial.println("All pins functional!");
}

void loop() {
    delay(1000);
}
