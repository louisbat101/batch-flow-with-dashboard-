    @Override
    public Response serve(IHTTPSession session) {
        String uri = session.getUri();
        String method = session.getMethod().toString();
        Map<String, String> body = null;

        if ("POST".equals(method)) {
            try {
                Map<String, String> files = new HashMap<>();
                session.parseBody(files);
                String rawBody = files.get("postData");
                if (rawBody != null && !rawBody.isEmpty()) {
                    body = new HashMap<>();
                    body.put("raw", rawBody);
                }
            } catch (Exception e) {
                // ignore parse errors
            }
        }

        // ── API: Serial Port Scan ───────────────────────
        if ("/api/serial/scan".equals(uri) && "GET".equals(method)) {
            // Query params: ?baud=9600&read=true
            int baud = 9600;
            boolean readData = false;
            String q = session.getQueryParameterString();
            if (q != null) {
                if (q.contains("baud=")) {
                    try {
                        String[] pairs = q.split("&");
                        for (String pair : pairs) {
                            String[] kv = pair.split("=");
                            if (kv[0].equals("baud")) baud = Integer.parseInt(kv[1]);
                            if (kv[0].equals("read")) readData = "true".equals(kv[1]);
                        }
                    } catch (Exception e) {}
                }
            }
            return jsonResponse(SerialPortScanner.scanWithBaud(baud, readData));
        }
        if ("/api/serial/fullscan".equals(uri) && "GET".equals(method)) {
            return jsonResponse(SerialPortScanner.fullBaudScan());
        }
        if ("/api/serial/listen".equals(uri) && "POST".equals(method)) {
            // Start listening: parse {"port":"/dev/ttysWK0","baud":9600}
            if (body != null && body.get("raw") != null) {
                try {
                    String raw = body.get("raw");
                    String port = "/dev/ttysWK0";
                    int baud = 9600;
                    String[] parts = raw.replace("{","").replace("}","").split(",");
                    for (String p : parts) {
                        p = p.trim();
                        if (p.startsWith("\"port\"")) port = p.split(":")[1].trim().replace("\"","");
                        if (p.startsWith("\"baud\"")) baud = Integer.parseInt(p.split(":")[1].trim());
                    }
                    SerialPortScanner.stopListening();
                    SerialPortScanner.startListening(port, baud);
                    return jsonResponse("{\"status\":\"listening\",\"port\":\"" + escapeJson(port) + "\",\"baud\":" + baud + "}");
                } catch (Exception e) {
                    return jsonResponse("{\"status\":\"error\",\"message\":\"" + escapeJson(e.getMessage()) + "\"}");
                }
            }
            return jsonResponse("{\"status\":\"error\",\"message\":\"missing body\"}");
        }
        if ("/api/serial/stop".equals(uri) && "POST".equals(method)) {
            SerialPortScanner.stopListening();
            return jsonResponse("{\"status\":\"stopped\"}");
        }
        if ("/api/serial/status".equals(uri) && "GET".equals(method)) {
            return jsonResponse("{\"listening\":" + SerialPortScanner.isListening() + "}");
        }

        // ── API: Board Status ────────────────────────────
        if ("/api/boards/status".equals(uri)) {
            return jsonResponse(getBoardsJson());
        }

        // ── API: Firmware Version ────────────────────────
        if ("/api/version".equals(uri)) {
            return jsonResponse("{\"version\":\"2.0.0\",\"build\":\"2025-06-13\"}");
        }

        // ── API: Products ────────────────────────────────
        if ("/api/products".equals(uri)) {
            if ("GET".equals(method)) {
                return jsonResponse(getProductsJson());
            }
            if ("POST".equals(method) && body != null) {
                return handleSaveProducts(body.get("raw"));
            }
        }

        // ── API: Board rename ────────────────────────────
        if ("/api/boards/rename".equals(uri) && "POST".equals(method)) {
            return jsonResponse("{\"status\":\"ok\",\"message\":\"Board renamed\"}");
        }

        // ── API: Run control ──────────────────────────────
        if ("/api/run/start".equals(uri) && "POST".equals(method)) {
            // Expect JSON: {"address": 1, "litres": 10.5}
            if (body != null && body.get("raw") != null) {
                String raw = body.get("raw");
                try {
                    // Simple parse: extract address and litres
                    int addr = 0;
                    String[] parts = raw.replace("{", "").replace("}", "").split(",");
                    for (String p : parts) {
                        p = p.trim();
                        if (p.startsWith("\"address\"")) {
                            addr = Integer.parseInt(p.split(":")[1].trim());
                        }
                    }
                    if (addr >= 1 && addr <= 10 && modbus != null) {
                        modbus.setValve(addr, true); // FC05: open valve
                        return jsonResponse("{\"status\":\"started\",\"address\":" + addr + "}");
                    }
                } catch (Exception e) {
                    return jsonResponse("{\"status\":\"error\",\"message\":\"" + escapeJson(e.getMessage()) + "\"}");
                }
            }
            return jsonResponse("{\"status\":\"started\"}");
        }
        if ("/api/run/stop".equals(uri) && "POST".equals(method)) {
            if (body != null && body.get("raw") != null) {
                String raw = body.get("raw");
                try {
                    int addr = 0;
                    String[] parts = raw.replace("{", "").replace("}", "").split(",");
                    for (String p : parts) {
                        p = p.trim();
                        if (p.startsWith("\"address\"")) {
                            addr = Integer.parseInt(p.split(":")[1].trim());
                        }
                    }
                    if (addr >= 1 && addr <= 10 && modbus != null) {
                        modbus.setValve(addr, false); // FC05: close valve
                        return jsonResponse("{\"status\":\"stopped\",\"address\":" + addr + "}");
                    }
                } catch (Exception e) {
                    return jsonResponse("{\"status\":\"error\",\"message\":\"" + escapeJson(e.getMessage()) + "\"}");
                }
            }
            return jsonResponse("{\"status\":\"stopped\"}");
        }

        // ── API: Loads ────────────────────────────────────
        if ("/api/loads".equals(uri)) {
            if ("GET".equals(method)) {
                return jsonResponse("{\"loads\":[]}");
            }
            if ("POST".equals(method) && body != null) {
                return jsonResponse("{\"status\":\"ok\"}");
            }
        }

        // ── Serve frontend files ─────────────────────────
        if ("/".equals(uri) || "/index.html".equals(uri)) {
            return newFixedLengthResponse(Response.Status.OK, "text/html; charset=utf-8", HTML);
        }
        if ("/dashboard.js".equals(uri)) {
            return newFixedLengthResponse(Response.Status.OK, "application/javascript; charset=utf-8", JS);
        }
        if ("/style.css".equals(uri)) {
            return newFixedLengthResponse(Response.Status.OK, "text/css; charset=utf-8", CSS);
        }

        return newFixedLengthResponse(Response.Status.NOT_FOUND, "text/plain", "Not found");
    }

    private String getBoardsJson() {
        StringBuilder j = new StringBuilder();
        j.append("[");
        for (int i = 1; i <= 4; i++) {
            if (i > 1) j.append(",");
            ModbusListener.BoardData b = boards[i];
            j.append("{\"address\":").append(b.address)
             .append(",\"name\":\"").append(escapeJson("Station " + b.address)).append("\"")
             .append(",\"online\":").append(b.online)
             .append(",\"dispensing\":").append(b.dispensing)
             .append(",\"dispensedAmount\":").append(String.format(Locale.US, "%.2f", b.dispensedLiters))
             .append(",\"targetAmount\":").append(String.format(Locale.US, "%.2f", b.targetLiters))
             .append("}");
        }
        j.append("]");
        return j.toString();
    }

    private String getProductsJson() {
        StringBuilder j = new StringBuilder();
        j.append("{\"products\":[");
        for (int i = 0; i < products.size(); i++) {
            if (i > 0) j.append(",");
            Map<String,Object> p = products.get(i);
            j.append("{\"id\":").append(p.get("id"))
             .append(",\"name\":\"").append(escapeJson((String)p.get("name"))).append("\"")
             .append(",\"pulsesPerLiter\":").append(p.get("pulsesPerLiter"))
             .append(",\"valveTime\":").append(p.get("valveTime"))
             .append(",\"calStatus\":\"").append(escapeJson((String)p.getOrDefault("calStatus","Not Calibrated"))).append("\"")
             .append(",\"calDate\":\"").append(escapeJson((String)p.getOrDefault("calDate",""))).append("\"")
             .append("}");
        }
        j.append("]}");
        return j.toString();
    }

    private Response handleSaveProducts(String rawJson) {
        return jsonResponse("{\"status\":\"ok\",\"message\":\"Products saved\"}");
    }

    private String escapeJson(String s) {
        if (s == null) return "";
        return s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t");
    }

    private Response jsonResponse(String json) {
        return newFixedLengthResponse(Response.Status.OK, "application/json; charset=utf-8", json);
    }


